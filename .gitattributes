# CRITICAL: cmd.exe on Windows misparses LF-only batch (setlocal -> tlocal).
# Keep these as binary so Git does NOT normalize CRLF -> LF in the blob
# (GitHub raw serves the blob; text/eol=crlf still stores LF in the repo).
own.cmd -text
own.txt -text
*.cmd -text
*.ps1 text eol=lf
*.py text eol=lf
*.md text eol=lf
zerocool.version text eol=lf
winrtcs.version text eol=lf
